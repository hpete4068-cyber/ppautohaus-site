---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { SITE } from '../lib/site';
import { dealerSchema } from '../lib/schema';
const a = SITE.address;
---
<Base title="Contact & Visit | Peters Prestige Autohaus, Brisbane" description="Contact Peters Prestige Autohaus. Visits by appointment in Brisbane." schema={dealerSchema}>
  <section class="section"><div class="wrap grid">
    <div>
      <p class="eyebrow">Contact</p>
      <h1>Visit by appointment</h1>
      <p>Call or email to arrange a time.</p>
      <div class="frame r-3x4 portrait">
        <Photo
          base="contact-storage-unveil"
          alt="A grey Ferrari in the storage showroom as a cover is lifted away."
          sizes="(max-width:760px) 100vw, 42vw"
          width={2400}
          height={3600}
          position="center 18%"
        />
      </div>
    </div>
    <div>
      <dl>
        <dt>Phone</dt><dd><a href={SITE.phoneHref}>{SITE.phone}</a></dd>
        <dt>Email</dt><dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
        <dt>Address</dt><dd>{a.street}<br />{a.locality} {a.region} {a.postcode}</dd>
      </dl>
      <div id="privacy">
        <h2>Enquiry details</h2>
        <p>If you ask for an appraisal, we use your name, mobile, email, postcode and the car details to reply to you. We don't sell those details. Photos you choose in the form stay on your device until you email them to us.</p>
      </div>
    </div>
  </div></section>
</Base>
<style>
.grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:start}
.portrait{margin-top:28px;max-height:720px}
dt{font:500 12px var(--sans);letter-spacing:.16em;text-transform:uppercase;color:var(--muted);margin-top:24px}
dd{margin:6px 0 0;font:400 26px var(--serif)}
#privacy{margin-top:48px;padding-top:28px;border-top:1px solid var(--line)}
#privacy h2{font-size:32px}
#privacy p{color:var(--ink-2);max-width:46ch}
@media(max-width:760px){.grid{grid-template-columns:1fr}}
</style>
