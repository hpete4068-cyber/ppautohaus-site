---
import Base from '../layouts/Base.astro';
import CarCard from '../components/CarCard.astro';
import { getStock } from '../lib/stock';
import { SITE } from '../lib/site';
import { dealerSchema } from '../lib/schema';
const stock = await getStock();
const featured = stock.filter(c => c.status !== 'sold').slice(0, 3);
const usingSample = stock.some(c => c.isSample);
// Vehicles listed as bought/sold on the current ppautohaus.com.au (Oct 2026).
const sold = ['1987 Ferrari Testarossa','2019 Aston Martin DB11','2020 Lamborghini Huracán EVO','1993 Bentley Continental R Coupe','2024 Porsche 911 Turbo S','1998 Aston Martin DB7'];
const paths = [
  { id:'buy', k:'01', t:'Buy', d:'Prestige, luxury, classic and supercars, inspected and presented properly.', cta:'View stock', h:'/stock' },
  { id:'sell', k:'02', t:'Sell & Consign', d:'We buy prestige, luxury, classic and supercars Australia-wide. Fast, fair offers with a hassle-free process.', cta:'Discuss your car', h:'/contact' },
  { id:'source', k:'03', t:'Source', d:'Looking for a specific vehicle? We search our network across Australia to a tailored brief.', cta:'Start a brief', h:'/contact' },
];
---
<Base title="Peters Prestige Autohaus | Prestige, Classic & Supercar Specialist, Brisbane"
  description="Brisbane-based specialist buying and selling prestige, luxury, classic and supercars Australia-wide. Sales, consignment, sourcing, storage and detailing."
  schema={dealerSchema}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Brisbane · Australia-wide</p>
        <h1>Prestige, classic &amp; supercars, bought and sold with care.</h1>
        <p class="lede">A Brisbane-based, family-owned specialist. We buy, sell, consign and source exceptional cars for clients across Australia.</p>
        <div class="ctas"><a class="btn btn-primary" href="/stock">View stock</a><a class="btn" href="#sell">Sell your car</a></div>
      </div>
      <div class="placeholder hero-img" role="img" aria-label="Placeholder image">Placeholder image · hero photograph</div>
    </div>
  </section>
  <hr class="rule" />
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">How we work</p>
      <div class="paths">
        {paths.map(p => <article id={p.id} class="path"><span class="k">{p.k}</span><h2>{p.t}</h2><p>{p.d}</p><a href={p.h}>{p.cta} →</a></article>)}
      </div>
    </div>
  </section>
  <section class="section stock">
    <div class="wrap">
      <div class="head"><div><p class="eyebrow">Current stock</p><h2>Featured</h2></div><a href="/stock">All stock →</a></div>
      {usingSample && <p class="note"><span class="sample-badge">SAMPLE</span> Sample listings shown until the stock register sheet is connected.</p>}
      <div class="cars">{featured.map(car => <CarCard car={car} />)}</div>
    </div>
  </section>
  <section class="section">
    <div class="wrap sold">
      <div><p class="eyebrow">Track record</p><h2>Recently bought &amp; sold</h2><p class="muted">A selection of cars that have passed through our hands.</p></div>
      <ul>{sold.map(s => <li>{s}</li>)}</ul>
    </div>
  </section>
  <section id="services" class="section svc">
    <div class="wrap">
      <p class="eyebrow">Also offered</p>
      <div class="svc-grid">
        <div><h3>Boutique storage</h3><p>Discreet, secure storage in South-West Brisbane with 24/7 back-to-base alarms and AI-enhanced CCTV.</p><a href={SITE.storageUrl}>Storage →</a></div>
        <div><h3>Detailing</h3><p>Ceramic coating, paint protection film, paint correction and full details.</p><a href="/contact">Enquire →</a></div>
      </div>
    </div>
  </section>
  <section class="cta">
    <div class="wrap cta-in">
      <h2>Buying, selling or searching?</h2>
      <p>By appointment. Speak directly with us.</p>
      <div class="ctas"><a class="btn btn-primary" href={SITE.phoneHref}>Call {SITE.phone}</a><a class="btn light" href={`mailto:${SITE.email}`}>Email us</a></div>
    </div>
  </section>
</Base>
<style>
.hero{padding:clamp(48px,7vw,96px) 0}
.hero-grid{display:grid;grid-template-columns:1.05fr 1fr;gap:56px;align-items:center}
.lede{font-size:18px;color:var(--ink-2);max-width:46ch;margin:0 0 32px}
.ctas{display:flex;gap:12px;flex-wrap:wrap} .hero-img{aspect-ratio:4/5}
.paths{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--ink)}
.path{padding:32px 32px 8px 0;border-right:1px solid var(--line)} .path+.path{padding-left:32px} .path:last-child{border-right:0}
.path p{color:var(--ink-2)} .path a{font:500 13px var(--sans);letter-spacing:.08em;text-transform:uppercase;text-decoration:none;color:var(--accent)}
.k{font:500 13px var(--sans);color:var(--muted);display:block;margin-bottom:24px}
.stock{background:var(--paper);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.head{display:flex;justify-content:space-between;align-items:end;margin-bottom:28px} .head a{font-size:14px}
.note{font-size:14px;color:var(--muted);display:flex;gap:10px;align-items:center}
.cars{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.sold{display:grid;grid-template-columns:1fr 1.3fr;gap:56px} .muted{color:var(--muted)}
.sold ul{list-style:none;margin:0;padding:0;border-top:1px solid var(--ink)}
.sold li{font:400 26px/1.2 var(--serif);padding:16px 0;border-bottom:1px solid var(--line)}
.svc{padding-top:0} .svc-grid{display:grid;grid-template-columns:1fr 1fr;gap:48px;border-top:1px solid var(--line);padding-top:32px}
.svc a{color:var(--accent);font-size:14px}
.cta{background:var(--accent);color:#fff;padding:96px 0;text-align:center} .cta .ctas{justify-content:center}
.cta .btn-primary{background:#fff;color:var(--accent);border-color:#fff} .light{border-color:#fff;color:#fff}
@media (max-width:860px){
  .hero-grid,.sold,.svc-grid{grid-template-columns:1fr;gap:32px} .hero-img{aspect-ratio:4/3}
  .paths,.cars{grid-template-columns:1fr} .path,.path+.path{padding:28px 0;border-right:0;border-bottom:1px solid var(--line)}
}
</style>
